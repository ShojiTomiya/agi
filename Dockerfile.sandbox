FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir \
    pandas matplotlib numpy scipy seaborn \
    openpyxl xlrd tabulate pillow scikit-learn requests \
    reportlab fpdf2 python-pptx python-docx \
    sympy statsmodels opencv-python-headless
# /workspace is the session's directory, mounted in when the container starts
WORKDIR /workspace
COPY repl_server.py /repl_server.py
